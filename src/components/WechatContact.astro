---
import IconX from "@/assets/icons/IconX.svg";
import { getAssetPath } from "@/utils/withBase";

const qrCode = getAssetPath("images/wechat-qr.jpg");
---

<dialog
  id="wechat-contact-dialog"
  class="wechat-dialog"
  aria-labelledby="wechat-contact-title"
  aria-describedby="wechat-contact-id"
>
  <div class="wechat-dialog-content">
    <button
      type="button"
      class="wechat-dialog-close hover:text-accent"
      data-wechat-close
      aria-label="关闭微信二维码"
      autofocus
    >
      <IconX width={24} height={24} aria-hidden="true" />
    </button>
    <h2 id="wechat-contact-title">微信联系我</h2>
    <p id="wechat-contact-id">微信号：<code>joker_mario</code></p>
    <img
      src={qrCode}
      alt="Jiankai 的微信二维码，扫码添加好友"
      width="888"
      height="1131"
      loading="lazy"
      decoding="async"
    />
    <a
      href={qrCode}
      download="Jiankai-微信二维码.jpg"
      class="border-border hover:border-accent hover:text-accent inline-flex min-h-10 items-center rounded-md border px-4 py-2 text-sm"
    >
      保存二维码
    </a>
  </div>
</dialog>

<script>
  // Handle the fallback links before Astro's client-side router.
  document.addEventListener(
    "click",
    event => {
      if (!(event.target instanceof Element)) return;

      const dialog = document.querySelector<HTMLDialogElement>(
        "#wechat-contact-dialog"
      );
      if (!dialog) return;

      const trigger = event.target.closest<HTMLAnchorElement>(
        "a[data-wechat-contact]"
      );
      if (trigger) {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }
        event.preventDefault();
        dialog.showModal();
        return;
      }

      if (
        event.target.closest("[data-wechat-close]") ||
        event.target === dialog
      ) {
        dialog.close();
      }
    },
    { capture: true }
  );

  document.addEventListener("astro:before-swap", () => {
    document
      .querySelector<HTMLDialogElement>("#wechat-contact-dialog")
      ?.close();
  });
</script>

<style>
  .wechat-dialog {
    width: min(24rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 25%);
  }

  .wechat-dialog::backdrop {
    background: rgb(0 0 0 / 60%);
    backdrop-filter: blur(4px);
  }

  .wechat-dialog-content {
    position: relative;
    padding: 1.25rem;
    text-align: center;
  }

  .wechat-dialog-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.5rem;
    border-radius: 0.375rem;
  }

  h2 {
    margin: 0 2rem;
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.5;
  }

  p {
    margin: 0.375rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(24rem, 52dvh);
    margin: 1rem auto;
    border-radius: 0.5rem;
    background: white;
  }

  :global(html:has(#wechat-contact-dialog[open])) {
    overflow: hidden;
  }
</style>
