---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { resolveTimezone } from "@/utils/resolveTimezone";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  showModified?: boolean;
};

const {
  pubDatetime,
  modDatetime,
  showModified = false,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const resolvedTimezone = resolveTimezone(postTimezone ?? config.site.timezone);
const published = dayjs(pubDatetime).tz(resolvedTimezone);
const modified = modDatetime ? dayjs(modDatetime).tz(resolvedTimezone) : null;
const showUpdatedAt = showModified && modified?.isAfter(published);
---

<div
  class:list={[
    "text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1",
    className,
  ]}
>
  <span class="inline-flex items-center gap-x-2">
    <IconCalendar
      class:list={[
        "inline-block size-6 min-w-5.5",
        { "scale-90": size === "sm" },
      ]}
    />
    {showModified && <span>{t.post.publishedAt}:</span>}
    <time
      class:list={["text-sm", { "sm:text-base": size === "lg" }]}
      datetime={published.toISOString()}
    >
      {published.format("YYYY 年 M 月 D 日")}
    </time>
  </span>
  {
    showUpdatedAt && modified && (
      <span class="inline-flex items-center gap-x-1 text-sm">
        <span aria-hidden="true">·</span>
        <span>{t.post.updatedAt}:</span>
        <time datetime={modified.toISOString()}>
          {modified.format("YYYY 年 M 月 D 日")}
        </time>
      </span>
    )
  }
</div>
